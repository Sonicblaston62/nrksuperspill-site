	<!-- dx/dy for each die is equal to 1 -->
	<!-- dice rotates around the origin -->
	<!-- configuration should be input in such a way that the DiceY array is ascending -->
		
	<DiceConfiguration>
		<!-- 0 - Single Die -->
		<DiceX type="Array">0</DiceX>
		<DiceY type="Array">0</DiceY>
	</DiceConfiguration>
		
	<DiceConfiguration>
		<!-- 1 - Two dice in a column -->
		<DiceX type="Array">0,0</DiceX>
		<DiceY type="Array">0,1</DiceY>
	</DiceConfiguration>
		
	<DiceConfiguration>
		<!-- 2 - Three dice in an L shape -->
		<DiceX type="Array">0.5,-0.5,0.5</DiceX>
		<DiceY type="Array">-0.5,0.5,0.5</DiceY>
	</DiceConfiguration>
				
	<DiceConfiguration>
		<!-- 3 - Three dice diagonally -->
		<DiceX type="Array">1,0,-1</DiceX>
		<DiceY type="Array">-1,0,1</DiceY>
	</DiceConfiguration> 
		
	<DiceConfiguration>
		<!-- 4 - Three dice horizontally -->
		<DiceX type="Array">-1,0,1</DiceX>
		<DiceY type="Array">0,0,0</DiceY>
	</DiceConfiguration>	

	<DiceConfiguration>
		<!-- 5 - Four corners -->
		<DiceX type="Array">-0.5,0.5,-0.5,0.5</DiceX>
		<DiceY type="Array">-0.5,-0.5,0.5,0.5</DiceY>
	</DiceConfiguration>	
		
	<DiceConfiguration>
		<!-- 6 - Cross with a hole in the center - using 4 dice -->
		<DiceX type="Array">0,-1,1,0</DiceX>
		<DiceY type="Array">-1,0,0,1</DiceY>
	</DiceConfiguration>
		
	<DiceConfiguration>
		<!-- 7 - Four corners not touching each other -->
		<DiceX type="Array">-1,1,-1,1</DiceX>
		<DiceY type="Array">-1,-1,1,1</DiceY>
	</DiceConfiguration>	
		
	<DiceConfiguration>
		<!-- 8 - Cross -->
		<DiceX type="Array">0,-1,0,1,0</DiceX>
		<DiceY type="Array">-1,0,0,0,1</DiceY>
	</DiceConfiguration>	
		
	<DiceConfiguration>
		<!-- 9 - L shape - using 5 dice -->
		<DiceX type="Array">-1,0,1,-1,-1</DiceX>
		<DiceY type="Array">-1,-1,-1,0,1</DiceY>
	</DiceConfiguration>
		
	<DiceConfiguration>
		<!-- 10 - X - using 5 dice -->
		<DiceX type="Array">-1,1,0,-1,1</DiceX>
		<DiceY type="Array">-1,-1,0,1,1</DiceY>
	</DiceConfiguration>
</ignoreMeContainer>

