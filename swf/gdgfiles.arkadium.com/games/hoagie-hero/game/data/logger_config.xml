<?xml version="1.0" encoding="UTF-8"?>

<logConfig>
	<messageTypes>
		<messageType name="SCORELOG">
			<param name="note" type="String"/>
			<param name="score" type="int"/>
            <param name="addedValue" type="int"/>
		</messageType>
		<messageType name="GAMELOADED">
			<param name="loadTime" type="int"/>
		</messageType>
		<messageType name="STARTGAME">
			<param name="loadTime" type="int"/>
		</messageType>
		<messageType name="ENDGAME">
			<param name="score" type="int"/>
		</messageType>
		<messageType name="FRAMERATE">
			<param name="fps" type="int"/>
		</messageType>
		<messageType name="ERROR">
			<param name="errorName" type="String"/>
			<param name="errorNote" type="String"/>
			<param name="errorNumber" type="String"/>
		</messageType>
		<messageType name="GOOGLECUSTOMEVENT">
			<param name="eventName" type="String"/>
			<param name="eventNote" type="String"/>
			<param name="eventNumber" type="String"/>
		</messageType>
	</messageTypes>
	<loggers>
		<logger id="test" url="data/external_loggers/google-analytics-logger.swf">
			<subscribe messageType="SCORELOG"/>
			<subscribe messageType="GAMELOADED"/>
			<subscribe messageType="STARTGAME"/>
			<subscribe messageType="ENDGAME"/>
			<subscribe messageType="FRAMERATE"/>
			<subscribe messageType="ERROR"/>
			<subscribe messageType="GOOGLECUSTOMEVENT"/>
		</logger>
		<logger id="test" url="data/external_loggers/gameplay-logger.swf">
			<subscribe messageType="SCORELOG"/>
			<subscribe messageType="STARTGAME"/>
			<subscribe messageType="ENDGAME"/>
		</logger>
	</loggers>
</logConfig>

